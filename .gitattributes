# Force LF (Unix) line endings for shell scripts
*.sh text eol=lf

# Force LF for all text files
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# Keep binary files binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.xz binary

# Keep Docker files binary
*Dockerfile binary

# For scripts with specific shebangs
*.pl text eol=lf
*.rb text eol=lf
*.py text eol=lf
